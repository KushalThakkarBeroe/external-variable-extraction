# Commodity Driver Pipeline - Environment Variables Template
# Never commit the real .env file (it contains secrets).
# Copy this to .env and fill in your actual values.

# ---- Anthropic API (Claude LLM) ----
ANTHROPIC_API_KEY= 'aaa'
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Data source API keys (free, self-signup) ----
